# ─────────────────────────────────────────────────────────────
# StorageIQ — Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to Git — it is already in .gitignore.
# ─────────────────────────────────────────────────────────────

# ── GitHub ────────────────────────────────────────────────────
# Personal Access Token with repo scope (or fine-grained: contents write)
# Create at: https://github.com/settings/tokens
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Your GitHub username/repo that will store the data JSON.
# The repo can be public (dashboard reads raw content) or private
# (dashboard needs the token too — keep it in a separate read-only token).
GITHUB_REPO=youruser/storageiq-data

# Branch to push data to (usually main)
GITHUB_BRANCH=main

# Path inside the repo where accounts.json lives
DATA_FILE=data/accounts.json

# ── Google Accounts ───────────────────────────────────────────
# Add one block per Google account you want to track.
# credentials_*.json = OAuth client secret downloaded from Google Cloud Console.
# token_*.json       = auto-created by sync.py on first run (browser auth).

# Account 0 — Personal
ACCOUNT_0_CREDENTIALS=credentials_account0.json
ACCOUNT_0_TOKEN=token_account0.json
ACCOUNT_0_LABEL=Personal

# Account 1 — Work
ACCOUNT_1_CREDENTIALS=credentials_account1.json
ACCOUNT_1_TOKEN=token_account1.json
ACCOUNT_1_LABEL=Work · RELX

# Account 2 — Side project
# ACCOUNT_2_CREDENTIALS=credentials_account2.json
# ACCOUNT_2_TOKEN=token_account2.json
# ACCOUNT_2_LABEL=VidhyAIm Dev

# ─────────────────────────────────────────────────────────────
# HOW TO GET credentials_*.json
# ─────────────────────────────────────────────────────────────
# 1. Go to https://console.cloud.google.com
# 2. Create a project (or use existing)
# 3. APIs & Services → Enable these APIs:
#      • Google Drive API
#      • Gmail API
#      • Photos Library API
# 4. APIs & Services → Credentials → Create OAuth 2.0 Client ID
#      • Application type: Desktop app
#      • Download JSON → rename to credentials_account0.json
# 5. OAuth consent screen → Add your email as Test User
# 6. Run:  python scripts/sync.py
#    A browser tab opens → sign in → token saved automatically.
# ─────────────────────────────────────────────────────────────
